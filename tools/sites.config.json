{
  "_doc": "Single source of truth for every site deploy. dir and worker_src are relative to the repo root. Read by deploylib.mjs (mkdeploy2, deploy-check, smoke). Do not hand-copy these into scripts. pages_redirect lists paths that permanently 301 to another host.",
  "_exceptions": {
    "_doc": "Sites that are NOT part of this deploy pipeline. Do not scaffold or convert these. Listed so onboarding sees the complete exception list.",
    "uptownjerky": "Client-managed Wix site. Not in this repo or the deploy pipeline. Hours and business facts are the client's to edit in Wix; we do not carry them.",
    "rexters": "Our self-storage platform in sites/rexters, live at rexters-preview.loadednacho.workers.dev (domain pending). Built from facilities/rexters.json, not in sites.config.json and not deployed by this pipeline. No hours markers.",
    "feast": "Draft, built from sites/feast-toc-src and uploaded by hand. Not deployed by this pipeline.",
    "toc": "Draft, built from sites/feast-toc-src and uploaded by hand. Not deployed by this pipeline.",
    "storage-api": "Internal storage admin API, uploaded by hand. Not a client site and not deployed by this pipeline."
  },
  "meiji": {
    "worker": "meiji-loadednacho",
    "dir": "sites/meiji/public",
    "worker_src": "sites/meiji/worker.js",
    "base": "https://meijiok.com",
    "biz": "meiji",
    "assets": {
      "html_handling": "auto-trailing-slash",
      "not_found_handling": "404-page",
      "run_worker_first": true
    },
    "headers_file": "_headers",
    "bindings": [
      {
        "type": "assets",
        "name": "ASSETS"
      },
      {
        "type": "d1",
        "name": "DB"
      },
      {
        "type": "service",
        "name": "PORTAL",
        "service": "ln-portal"
      },
      {
        "type": "secret_text",
        "name": "BREVO_API_KEY"
      }
    ],
    "crons": [
      "0 9 * * *"
    ],
    "noindex": false,
    "pages_200": [
      "/",
      "/menu",
      "/locations"
    ],
    "module_pages": {
      "/careers": "applications",
      "/reservations": "reservations",
      "/catering": "catering",
      "/blog": "blog"
    },
    "fresh_files": [
      "assets/styles.css"
    ]
  },
